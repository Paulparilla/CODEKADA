{
  "manifest_version": 3,
  "name": "FocusForge Shield",
  "version": "1.0",
  "description": "Blurs distracting websites when your FocusForge timer is active.",
  "permissions": ["tabs", "storage", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "FocusForge Shield"
  }
}
