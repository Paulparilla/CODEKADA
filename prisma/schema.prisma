generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// User model represents the application profile linked to Supabase Auth
// NOTE: Passwords are NOT stored here. They are managed securely by Supabase in the `auth.users` table.
model User {
  id            String   @id @default(uuid()) // Matches Supabase Auth ID
  email         String   @unique
  password      String?  // Manually hashed password (User Request)
  name          String?
  role          Role     @default(STUDENT)
  avatar        String?
  xp            Int      @default(0)
  level         Int      @default(1)
  streak        Int      @default(0)
  lastStreakDate DateTime?
  totalStudyTime Int     @default(0) // minutes
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  profile       Profile?
  memberships   ClassMember[]
  taughtClasses Class[]     @relation("TeacherClasses")
  sessions      StudySession[]
  schedules     Schedule[]
  rewardClaims  RewardClaim[]
  penalties     Penalty[]
  notifications Notification[]
  announcements Announcement[]
  comments      Comment[]
  reactions     Reaction[]
  quizSubmissions QuizSubmission[]
}

model Profile {
  id          String @id @default(uuid())
  userId      String @unique
  bio         String?
  timezone    String @default("Asia/Manila")
  user        User   @relation(fields: [userId], references: [id])
}

model Class {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  teacherId   String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  teacher     User         @relation("TeacherClasses", fields: [teacherId], references: [id])
  members     ClassMember[]
  schedules   Schedule[]
  sessions    StudySession[]
  announcements Announcement[]
  assignments   Assignment[]
  documents     Document[]
  quizzes       Quiz[]
}

model Announcement {
  id        String   @id @default(uuid())
  classId   String
  authorId  String
  content   String
  type      AnnouncementType @default(GENERAL)
  attachmentId String?
  createdAt DateTime @default(now())

  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id])
  comments  Comment[]
  reactions Reaction[]
}

model Comment {
  id             String   @id @default(uuid())
  announcementId String
  authorId       String
  content        String
  createdAt      DateTime @default(now())

  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  author         User         @relation(fields: [authorId], references: [id])
}

model Reaction {
  id             String   @id @default(uuid())
  announcementId String
  userId         String
  emoji          String   @default("👍")

  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id])

  @@unique([announcementId, userId, emoji])
}

model Assignment {
  id          String   @id @default(uuid())
  classId     String
  title       String
  description String?
  dueDate     DateTime?
  xpReward    Int      @default(100)
  createdAt   DateTime @default(now())

  class       Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
}

model Document {
  id        String   @id @default(uuid())
  classId   String
  name      String
  url       String
  type      String   // e.g. "PDF", "DOCX"
  createdAt DateTime @default(now())

  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
}

model ClassMember {
  id        String   @id @default(uuid())
  classId   String
  userId    String
  joinedAt  DateTime @default(now())

  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([classId, userId])
}

model Schedule {
  id           String   @id @default(uuid())
  classId      String?
  userId       String? 
  title        String?
  startTime    DateTime
  duration     Int      // minutes
  isExamMode   Boolean  @default(false)
  isRecurring  Boolean  @default(false)
  recurrence   String?  // e.g. "weekly"
  createdAt    DateTime @default(now())

  class        Class?   @relation(fields: [classId], references: [id])
  user         User?    @relation(fields: [userId], references: [id])
  sessions     StudySession[]
}

model StudySession {
  id           String        @id @default(uuid())
  userId       String
  classId      String?
  scheduleId   String?
  startedAt    DateTime
  endedAt      DateTime?
  plannedDuration Int
  actualDuration Int        @default(0)
  status       SessionStatus @default(PENDING)
  xpEarned     Int           @default(0)
  completedAt  DateTime?
  focusScore   Int?          // 0-100

  user         User          @relation(fields: [userId], references: [id])
  class        Class?        @relation(fields: [classId], references: [id])
  schedule     Schedule?     @relation(fields: [scheduleId], references: [id])
  penalties    Penalty[]
}

model Reward {
  id          String   @id @default(uuid())
  name        String
  description String?
  cost        Int
  type        RewardType
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  claims      RewardClaim[]
}

model RewardClaim {
  id        String   @id @default(uuid())
  userId    String
  rewardId  String
  claimedAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
  reward    Reward   @relation(fields: [rewardId], references: [id])

  @@unique([userId, rewardId, claimedAt])
}

model Penalty {
  id          String   @id @default(uuid())
  userId      String
  sessionId   String?
  reason      String
  xpLost      Int
  streakReset Boolean  @default(false)
  createdAt   DateTime @default(now())

  user        User          @relation(fields: [userId], references: [id])
  session     StudySession? @relation(fields: [sessionId], references: [id])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  type      NotificationType @default(INFO)
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

enum SessionStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
  PENALIZED
}

enum RewardType {
  BADGE
  PERK
  CERTIFICATE
  RECOGNITION
  ITEM
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
  XP
  CLASS
  EXAM
  QUIZ
}

model Quiz {
  id          String   @id @default(uuid())
  classId     String
  title       String
  description String?
  xpReward    Int      @default(250)
  timeLimit   Int      @default(30) // minutes
  createdAt   DateTime @default(now())

  class       Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  questions   Question[]
  submissions QuizSubmission[]
}

model Question {
  id          String   @id @default(uuid())
  quizId      String
  content     String
  type        QuestionType
  options     Json?    // Array of strings for MCQ
  correctAnswer String
  explanation String?

  quiz        Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
}

model QuizSubmission {
  id          String   @id @default(uuid())
  quizId      String
  userId      String
  score       Int
  totalQuestions Int
  xpEarned    Int
  completedAt DateTime @default(now())

  quiz        Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum QuestionType {
  MCQ
  FILL_IN_BLANKS
  ESSAY
}

enum AnnouncementType {
  GENERAL
  QUIZ
  ASSIGNMENT
  DOCUMENT
}
